<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="TP-Link Archer C54"
        android:textColor="@color/primary_dark_navy"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:text="@string/dashboard_title"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <!-- স্ট্যাটাস কার্ড -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Router IP: 192.168.0.1"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="#E2E8F0" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRouterStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Status: Not Tested"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvResponseTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- ms"
                    android:textColor="@color/accent_blue"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- কানেকশন টেস্ট বাটন -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCheckConnection"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="12dp"
        android:text="@string/check_connection"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/accent_blue" />

    <!-- কাস্টমার ম্যানেজমেন্ট পেজে যাওয়ার বাটন -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenCustomers"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/manage_customers"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/primary_dark_navy" />

</LinearLayout>
